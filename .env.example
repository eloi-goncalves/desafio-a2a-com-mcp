# Variaveis de ambiente do desafio. Copie para .env (ou exporte no shell).
# NUNCA comite o valor real de REQUEST_STATE_SECRET: o repositorio e publico.

# Chave de integridade do requestState (minimo 32 bytes de aleatoriedade).
# Gere a sua com:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
REQUEST_STATE_SECRET=

# Servidor MCP
MCP_HOST=127.0.0.1
MCP_PORT=7301

# Agente A2A
AGENTE_HOST=127.0.0.1
AGENTE_PORT=7300

# URL que o agente usa para falar com o servidor MCP (dois processos separados).
MCP_URL=http://localhost:7301/mcp
